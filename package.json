{
	"name": "obsidian-viewpoint",
	"private": true,
	"version": "1.0.0",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "vite build --mode development --watch",
		"build": "vite build --mode production",
		"build:dev": "vite build --mode development",
		"verify:release": "bun run scripts/verify-release.ts",
		"verify:artifacts": "bun run scripts/verify-artifacts.ts",
		"release:prepare": "bun run scripts/prepare-release.ts",
		"git:check": "bun run verify:release && bun run test && bun run check && bun run lint && bun run build && bun run verify:artifacts",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test ./src ./tests",
		"test:watch": "bun test --watch ./src ./tests",
		"format": "biome format --write ./src ./scripts ./tests",
		"lint": "biome lint ./src ./scripts ./tests",
		"lint:fix": "biome lint --write ./src ./scripts ./tests",
		"release:publish": "bun run scripts/publish-release.ts",
		"release:status": "bun run scripts/release-status.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^25.5.0",
		"builtin-modules": "^5.0.0",
		"bun-types": "^1.3.11",
		"obsidian": "^1.12.3",
		"svelte": "^5.54.1",
		"svelte-check": "^4.4.5",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "^8.0.1"
	},
	"dependencies": {
		"@chenglou/pretext": "^0.0.3",
		"@types/js-yaml": "^4.0.9",
		"js-yaml": "^4.1.1",
		"svelte-pan-zoom": "^0.0.13"
	},
	"license": "MIT",
	"description": "Explore connected notes through dimensions, groups, and spectra in Obsidian.",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ixniyevonn/obsidian-viewpoint.git"
	},
	"packageManager": "bun@1.3.14"
}
